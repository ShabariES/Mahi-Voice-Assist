DATABASE_URL=sqlite:///./voice_form.db
JWT_SECRET=replace-with-a-long-random-secret
APP_ENV=development
SEED_DEMO_DATA=false
# Optional: bootstrap the first admin account on an empty database, then remove these values.
BOOTSTRAP_ADMIN_NAME=System Admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
OPENAI_API_KEY=
GROQ_API_KEY=
SARVAM_API_KEY=your-sarvam-subscription-key
GROQ_NAV_MODEL=openai/gpt-oss-20b
GOOGLE_CLIENT_ID=408241181373-pi1t5jhsc8osii2rosp5pld0taf1itia.apps.googleusercontent.com

# SMTP settings for the automatic form-completion welcome email.
# Use starttls for port 587 or ssl for port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_SECURITY=starttls
PDF_OCR_LANG=ta

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173
